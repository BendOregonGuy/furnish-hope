# Furnish Hope API — environment template.
# Copy this file to `.env` (which is gitignored) and fill in real values.

# --- Postgres connection ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=changeme
PGDATABASE=furnish_hope

# --- API server ---
PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- Session ---
# REQUIRED. 32-byte random hex. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this value logs every active user out.
SESSION_SECRET=replace-me-with-a-real-secret

# Set to "true" when serving the API over HTTPS in production.
SESSION_SECURE=
