# Furnish Hope API — local development environment template.
#
# Copy this file to `.env` (which is gitignored) and customize the values
# you want. The defaults below work for a fresh local install with
# Postgres on localhost using the standard postgres/postgres dev creds.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash/zsh:    cp .env.example .env
#
# Production env vars are managed in DigitalOcean App Platform —
# see docs/SETUP_DIGITAL_OCEAN.md.

# --- Postgres connection (local) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=furnish_hope
# SSL mode for the Postgres connection. Leave blank for localhost;
# set to "require" or "verify-full" for cloud DBs like DO Managed
# Postgres (production sets this via the DO app spec).
# PGSSLMODE=

# --- API server ---
PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Session ---
# REQUIRED. 32-byte random hex used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this value logs every active user out.
SESSION_SECRET=replace-me-with-a-real-32-byte-hex-secret

# Set to "true" when serving the API over HTTPS in production. Leave
# blank for localhost development.
SESSION_SECURE=

# --- Encryption-at-rest for email OAuth tokens + IMAP/SMTP passwords ---
# Optional locally: if unset, the code derives a key from SESSION_SECRET
# with a warning. Set explicitly in production so the two secrets can
# rotate independently.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# EMAIL_ENCRYPTION_KEY=

# --- Nightly client-dedup scan ---
# Uncomment to silence the 02:00 cron locally so it doesn't spam your
# console. Production should leave this unset.
# DISABLE_DEDUP_CRON=1

# --- QuickBooks (optional, only if testing the QBO integration locally) ---
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=http://localhost:4000/api/quickbooks/callback
# QBO_ENVIRONMENT=sandbox

# --- Google / Microsoft OAuth (optional; needed for "Sign in with Google"
# email accounts in local dev). See docs/OAUTH_SETUP.md for setup. ---
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# APP_BASE_URL=http://localhost:4000
